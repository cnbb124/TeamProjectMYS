  m_EditorClassIdentifier: 
  memo: "\uC0AC\uC6A9\uC2DC SoundManager.Instance.\uD568\uC218\uBA85\n\uC0AC\uC6B4\uB4DC
    \uB370\uC774\uD130 \uB4F1\uB85D\uC2DC \uD544\uC694\uD55C\uB9CC\uD07C \uB9AC\uC2A4\uD2B8
    \uC6B0\uCE21 \uC22B\uC790\uBCC0\uACBD\n=== \uC0AC\uC6A9 \uAC00\uB2A5\uD55C \uD568\uC218
    \uBAA9\uB85D ===\n1. PlayBGM(SOUND_TYPE) - \uBC30\uACBD\uC74C \uC7AC\uC0DD\uD568\n2.
    PlayUISFX(SOUND_TYPE) - UI(2D)\uD6A8\uACFC\uC74C \uC7AC\uC0DD\uD568\n3. Play3DSFXAtPosition(SOUND_TYPE,
    Vector3) - 3D \uD6A8\uACFC\uC74C \uC7AC\uC0DD\uD568\n\u203B \uD50C\uB808\uC774
    \uD568\uC218 \uB4A4\uC5D0 \uD53C\uCE58\uAC12(float\uD615 min, max) \uCD94\uAC00
    \uC2DC \uB79C\uB364 \uC7AC\uC0DD\uB428(\uC624\uBC84\uB85C\uB529)\n4. StopBGM()
    - \uBC30\uACBD\uC74C \uC815\uC9C0\uD568\n5. StopAll() - \uBAA8\uB4E0 \uC18C\uB9AC
    \uC815\uC9C0\uD568\n=== \uBCF8\uC778\uC774 \uD544\uC694\uD55C \uBA54\uBAA8 \uC0AC\uC6A9
    \uBC11\uC73C\uB85C \uCD94\uAC00 ===\n"
