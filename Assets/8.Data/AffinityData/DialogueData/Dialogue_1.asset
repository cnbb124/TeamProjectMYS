  m_Script: {fileID: 11500000, guid: f304ed153a86bba43ba4ab443c0c92e4, type: 3}
  m_Name: Dialogue_1
  m_EditorClassIdentifier: 
  question: '"What are you looking for? Feel free to browse around!"'
  choices:
  - choiceText: '"Just browsing for parts today."'
    affinityDelta: 1
    mood: 0
    responseLine: '"Take your time. Everything here''s been checked twice - by me."'
    oneTime: 0
    nextDialogue: {fileID: 0}
  - choiceText: '"Show me your best gear. I trust your taste."'
    affinityDelta: 5
    mood: 2
    responseLine: '"Good instincts. Let me pull out the pieces I''ve been saving."'
    oneTime: 0
    nextDialogue: {fileID: 0}
  - choiceText: '"Honestly? I mostly came to see you."'
    affinityDelta: 8
    mood: 1
    responseLine: "\"Oh\u2014 well. The wares can wait, then. It's good to see you
      too, pilot.\""
    oneTime: 0
    nextDialogue: {fileID: 0}
  - choiceText: '"Let''s make this quick. I''m busy."'
    affinityDelta: -3
    mood: 3
    responseLine: '"...Right. Business as usual. The shelves are over there."'
    oneTime: 0
    nextDialogue: {fileID: 0}
