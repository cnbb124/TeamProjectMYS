  m_Script: {fileID: 11500000, guid: f304ed153a86bba43ba4ab443c0c92e4, type: 3}
  m_Name: Dialogue_1
  m_EditorClassIdentifier: 
  question: "\"\uC5B4\uB5A4 \uAC78 \uCC3E\uACE0 \uACC4\uC2E0\uAC00\uC694? \uD3B8\uD558\uAC8C
    \uB458\uB7EC\uBCF4\uC138\uC694!\""
  choices:
  - choiceText: "\"\uC624\uB298\uC740 \uADF8\uB0E5 \uBD80\uD488 \uC880 \uB458\uB7EC\uBCF4\uB7EC
      \uC654\uC5B4\uC694.\""
    affinityDelta: 1
    mood: 0
    responseLine: "\"\uCC9C\uCC9C\uD788 \uD558\uC138\uC694. \uC5EC\uAE30 \uC788\uB294
      \uAC74 \uBAA8\uB450 \uC81C\uAC00 \uB450 \uBC88\uC529 \uD655\uC778\uD588\uC2B5\uB2C8\uB2E4.\""
    oneTime: 0
    nextDialogue: {fileID: 0}
  - choiceText: "\"\uAC00\uC7A5 \uC88B\uC740 \uC7A5\uBE44\uB97C \uBCF4\uC5EC\uC8FC\uC138\uC694.
      \uC804 \uB2F9\uC2E0\uC758 \uC548\uBAA9\uC744 \uBBFF\uC5B4\uC694.\""
    affinityDelta: 5
    mood: 1
    responseLine: "\"\uAC10\uC774 \uC88B\uC73C\uC2DC\uB124\uC694. \uC81C\uAC00 \uB530\uB85C
      \uCC59\uACA8\uB454 \uAC83\uB4E4\uC744 \uAEBC\uB0B4 \uBCFC\uAC8C\uC694.\""
    oneTime: 0
    nextDialogue: {fileID: 0}
  - choiceText: "\uC194\uC9C1\uD788 \uB9D0\uD574\uC11C\uC694? \uC8FC\uB85C \uB2F9\uC2E0\uC744
      \uBCF4\uB7EC \uC654\uC5B4\uC694."
    affinityDelta: 8
    mood: 2
    responseLine: "\"\uC544, \uADF8\uB807\uAD70\uC694. \uADF8\uB7FC \uBB3C\uAC74\uC740
      \uB098\uC911\uC5D0 \uBD10\uB3C4 \uB418\uACA0\uB124\uC694. \uC800\uB3C4 \uBC18\uAC00\uC6CC\uC694,
      \uD30C\uC77C\uB7FF\uB2D8.\""
    oneTime: 0
    nextDialogue: {fileID: 0}
  - choiceText: "\"\uBE68\uB9AC \uB05D\uB0B4\uC8E0. \uBC14\uC058\uAC70\uB4E0\uC694.\""
    affinityDelta: -3
    mood: 3
    responseLine: "\"...\uADF8\uB807\uC8E0. \uD3C9\uC18C\uB300\uB85C \uD558\uBA74
      \uB429\uB2C8\uB2E4. \uC120\uBC18\uC740 \uC800\uCABD\uC5D0 \uC788\uC5B4\uC694.\""
    oneTime: 0
    nextDialogue: {fileID: 0}
