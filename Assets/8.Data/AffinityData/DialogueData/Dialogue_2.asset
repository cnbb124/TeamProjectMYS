  m_Script: {fileID: 11500000, guid: f304ed153a86bba43ba4ab443c0c92e4, type: 3}
  m_Name: Dialogue_2
  m_EditorClassIdentifier: 
  question: '"Oh, Thanks! Talking with you like this... it makes the outpost feel
    less empty. What''s on your mind, pilot?"'
  choices:
  - choiceText: '"Tell me about this outpost. It''s an old model, isn''t it?"'
    affinityDelta: 2
    mood: 0
    responseLine: "\"Sharp eye. She's older than both of us combined \u2014 but she
      holds. Just like me.\""
    oneTime: 0
    nextDialogue: {fileID: 0}
  - choiceText: '"I was wondering how you''ve been out here, all alone."'
    affinityDelta: 5
    mood: 1
    responseLine: '"Worried about me? The station keeps me busy... but it''s nice
      that someone finally asked."'
    oneTime: 0
    nextDialogue: {fileID: 0}
  - choiceText: '"Hmm...Well, After Talking to you, I don''t have any worries left!"'
    affinityDelta: 8
    mood: 2
    responseLine: '"Really?? You''re so nice guy! Come here! I''ll present our products
      with reasonable values!'
    oneTime: 1
    nextDialogue: {fileID: 0}
  - choiceText: '"Nothing much. I was just killing time here."'
    affinityDelta: -3
    mood: 3
    responseLine: '"...Killing time. Right. Well, don''t let me keep you from something
      more '
    oneTime: 0
    nextDialogue: {fileID: 0}
