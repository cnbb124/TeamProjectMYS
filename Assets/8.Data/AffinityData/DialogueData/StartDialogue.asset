  m_Script: {fileID: 11500000, guid: f304ed153a86bba43ba4ab443c0c92e4, type: 3}
  m_Name: StartDialogue
  m_EditorClassIdentifier: 
  question: "\uB4DC\uB9AC\uD504\uD2B8\uC2A4\uD30C\uC774\uC5B4\uC5D0 \uB2E4\uC2DC
    \uC624\uC2E0 \uAC83\uC744 \uD658\uC601\uD569\uB2C8\uB2E4, \uD30C\uC77C\uB7FF\uB2D8!
    \uBCC4\uB4E4\uB3C4, \uADF8\uB9AC\uACE0 \uC800\uB3C4 \uB2F9\uC2E0\uC758 \uC790\uB9AC\uB97C
    \uB530\uB73B\uD558\uAC8C \uBE44\uC6CC\uB450\uACE0 \uAE30\uB2E4\uB9AC\uACE0 \uC788\uC5C8\uC2B5\uB2C8\uB2E4."
  choices:
  - choiceText: "\uC548\uB155\uD558\uC138\uC694, \uADF8 \uBB3C\uAC74\uC744 \uC880
      \uC0B4\uD3B4\uBD10\uB3C4 \uB420\uAE4C\uC694?"
    affinityDelta: 1
    mood: 0
    responseLine: "\"\uB124, \uBB3C\uB860\uC774\uC8E0! \uAE30\uAEBC\uC774\uC694!\""
    oneTime: 0
    nextDialogue: {fileID: 11400000, guid: dd62d7cdd547d3d4b837b25e958b56be, type: 2}
  - choiceText: "\uC815\uB9D0 \uCE5C\uC808\uD558\uC2DC\uB124\uC694. \uADF8\uB9AC\uACE0
      \uC7AC\uBBF8\uC788\uC73C\uC2DC\uAE30\uB3C4 \uD558\uACE0\uC694."
    affinityDelta: 5
    mood: 1
    responseLine: "\"\uD760\uD760! \uCE6D\uCC2C \uAC10\uC0AC\uD569\uB2C8\uB2E4!\""
    oneTime: 0
    nextDialogue: {fileID: 11400000, guid: bb2afbd1dae90304e881ec6d059a65c9, type: 2}
  - choiceText: "\uBCF4\uACE0 \uC2F6\uC5C8\uC5B4\uC694..."
    affinityDelta: 8
    mood: 2
    responseLine: "\"\uC815\uB9D0\uC694? ...\uACE0\uB9C8\uC6CC\uC694. \uC800\uB3C4
      \uAC19\uC740 \uC0DD\uAC01\uC774\uC5C8\uC5B4\uC694.\""
    oneTime: 1
    nextDialogue: {fileID: 0}
  - choiceText: "\uADF8\uB0E5 \uBB50 \uC880 \uC0AC\uB7EC \uC654\uC5B4\uC694..."
    affinityDelta: -3
    mood: 3
    responseLine: "\"...\uC544. \uADF8\uB807\uC9C0, \uC6A9\uAC74\uC774 \uC788\uC5B4\uC11C
      \uC624\uC168\uC8E0.\""
    oneTime: 0
    nextDialogue: {fileID: 0}
  - choiceText: "\uB2F9\uC2E0\uC758 \uBE44\uBC00\uC744 \uD604\uC0C1\uAE08 \uC0AC\uB0E5\uAFBC\uC5D0\uAC8C
      \uD314\uC558\uC5B4\uC694."
    affinityDelta: -10
    mood: 4
    responseLine: "\"\uB124?...\uBB50\uB77C\uACE0\uC694? \uC804... \uC804 \uB110
      \uBBFF\uC5C8\uC5B4\uC694. \uB098\uAC00\uC138\uC694... \uADF8\uB9AC\uACE0 \uB2E4\uC2DC\uB294
      \uB3CC\uC544\uC624\uC9C0 \uB9C8\uC138\uC694!!\""
    oneTime: 1
    nextDialogue: {fileID: 0}
